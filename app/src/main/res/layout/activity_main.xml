<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="悬浮倒计时助手 设置"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 悬浮窗服务开关与权限状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_perm_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="悬浮窗权限: 检查中..."
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_request_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="授予悬浮窗权限" />

            <Button
                android:id="@+id/btn_toggle_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="开启悬浮球服务" />
        </LinearLayout>

        <!-- 调试与日志功能 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="调试与运行日志"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_copy_logs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📋 复制运行日志" />

                <Button
                    android:id="@+id/btn_clear_logs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="🗑️ 清理日志" />
            </LinearLayout>
        </LinearLayout>

        <!-- 外观与主题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="外观与样式"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_theme_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="深色模式" />

            <RadioButton
                android:id="@+id/rb_theme_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="浅色模式" />

            <RadioButton
                android:id="@+id/rb_theme_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跟随系统" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cb_show_ring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="倒计时显示环形进度条" />

        <CheckBox
            android:id="@+id/cb_change_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="倒计时进行中改变悬浮球高亮背景" />

        <!-- 默认单次加时额度设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="默认单次加时额度 (选择加时选项)"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/rg_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 添加自定义加时额度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_custom_step"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="输入自定义秒数 (如 45)"
                android:inputType="number"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_add_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="添加额度" />

            <Button
                android:id="@+id/btn_delete_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="删除当前选中" />
        </LinearLayout>

        <!-- 视觉提醒动画设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="视觉提醒与动画 (Shake / Flash)"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_shake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="倒计时结束触发悬浮球抖动 (Shake)" />

        <CheckBox
            android:id="@+id/cb_flash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="倒计时结束触发悬浮球闪烁 (Flash)" />

        <!-- 震动设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="震动提醒设置"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_vibrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="倒计时结束启用震动" />

        <TextView
            android:id="@+id/tv_vibrate_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="震动时长: 1.0 秒"
            android:textColor="?android:attr/textColorPrimary" />

        <SeekBar
            android:id="@+id/sb_vibrate_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3000"
            android:progress="1000" />

        <!-- 响铃 (Beep) 设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="响铃 (Beep蜂鸣) 设置"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_ringtone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="倒计时结束启用响铃" />

        <RadioGroup
            android:id="@+id/rg_beep_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_beep_05s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.5秒蜂鸣" />

            <RadioButton
                android:id="@+id/rb_beep_1s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0秒蜂鸣" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_beep_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="蜂鸣音量: 80%"
            android:textColor="?android:attr/textColorPrimary" />

        <SeekBar
            android:id="@+id/sb_beep_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="80" />

        <!-- 综合测试预览按钮 -->
        <Button
            android:id="@+id/btn_test_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#E91E63"
            android:text="⚡ 测试倒计时结束提醒与动画 (预览)"
            android:textColor="#FFFFFF" />

        <!-- 通知选项 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="其他选项"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_allow_notif_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="允许点击通知栏停止提醒" />

    </LinearLayout>
</ScrollView>
